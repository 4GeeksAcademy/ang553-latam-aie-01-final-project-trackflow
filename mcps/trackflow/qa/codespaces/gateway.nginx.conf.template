server {
    listen 8080;
    server_name _;
    server_tokens off;

    client_max_body_size 1m;

    location ~ ^/(admin|realms/master)(/|$) {
        return 404;
    }

    location = /mcp {
        proxy_pass http://host.docker.internal:18084;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location = /.well-known/oauth-protected-resource/mcp {
        proxy_pass http://host.docker.internal:18084;
        proxy_http_version 1.1;
        proxy_set_header Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location = /realms/${QA_KEYCLOAK_REALM}/.well-known/openid-configuration {
        proxy_pass http://keycloak:8080;
        proxy_http_version 1.1;
        proxy_set_header Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location ~ ^/realms/${QA_KEYCLOAK_REALM}/protocol/openid-connect/(auth|token|certs)(/|$) {
        proxy_pass http://keycloak:8080;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location ~ ^/realms/${QA_KEYCLOAK_REALM}/login-actions/ {
        proxy_pass http://keycloak:8080;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location ^~ /resources/ {
        proxy_pass http://keycloak:8080;
        proxy_http_version 1.1;
        proxy_set_header Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${TRACKFLOW_CODESPACES_PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        return 404;
    }
}
