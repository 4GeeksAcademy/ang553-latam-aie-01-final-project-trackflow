# ── Version control ──────────────────────────────────────────────────────────
.git/
.gitattributes
.gitignore
.github/

# ── Python byte-code / cache ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
.virtualenvs/

# ── Environment files (sensitive) ──────────────────────────────────────────
.env
.env.*
env.example

# ── Local databases and runtime-owned service data ─────────────────────────
services/api/data/
*.db
*.db-*
*.sqlite
*.sqlite3

# ── Local certificates and private keys ─────────────────────────────────────
*.key
*.pem
*.p12
*.pfx

# ── Generated/raw business artifacts not required by backend images ────────
data/raw/*
!data/raw/README.md
!data/raw/README.es.md

# ── Node / frontend artefacts (not needed by backend build) ─────────────────
node_modules/
.next/

# ── Logs / temp ─────────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/

# ── OS artefacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Docker artefacts ────────────────────────────────────────────────────────
.dockerignore

# Ignore the UI directory — not needed by backend build
uis/

# Ignore nested Docker context rules; service Dockerfiles remain explicit inputs.
services/.dockerignore
