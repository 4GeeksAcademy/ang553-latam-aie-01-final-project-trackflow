# ── TrackFlow environment variables ──────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# The application reads these variables directly from the environment.
# ─────────────────────────────────────────────────────────────────────────────

# Database (required by the API)
DATABASE_URL=

# JWT (required)
JWT_SECRET_KEY="change-me-to-a-long-random-string"

# JWT (optional, with defaults)
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=60

# Password-reset token (optional, with defaults)
RESET_TOKEN_EXPIRE_MINUTES=30

# Resend (email provider)
RESEND_API_KEY="re_xxxxxxxxxxxx"
FRONTEND_URL="http://localhost:3000"
# Backend URL for Next.js server-side rewrites (Docker DNS)
# This is used by the backoffice Next.js server to reach FastAPI internally.
# In Docker Compose, this resolves via Docker DNS to the api service.
API_BACKEND_URL="http://api:8000"
