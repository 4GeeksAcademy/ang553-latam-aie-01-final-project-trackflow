# ── TrackFlow environment variables ──────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# The application reads these variables directly from the environment.
# ─────────────────────────────────────────────────────────────────────────────

# Database (required by the API)
DATABASE_URL=

# JWT (required)
JWT_SECRET_KEY="change-me-to-a-long-random-string"

# JWT (optional, with defaults)
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=60

# Password-reset token (optional, with defaults)
RESET_TOKEN_EXPIRE_MINUTES=30

# Resend (email provider)
RESEND_API_KEY="re_xxxxxxxxxxxx"
FRONTEND_URL="http://localhost:3000"
# Backend URL for Next.js server-side rewrites (Docker DNS)
# This is used by the backoffice Next.js server to reach FastAPI internally.
# In Docker Compose, this resolves via Docker DNS to the api service.
API_BACKEND_URL="http://api:8000"

# RAG / Knowledge Base. Keep FOUR_GEEKS_API_KEY private and server-side only.
FOUR_GEEKS_BASE_URL="https://llm.4geeks.ai/v1"
FOUR_GEEKS_API_KEY=
RAG_EMBEDDING_MODEL="online/openrouter/perplexity/pplx-embed-v1-0.6b"
RAG_GENERATION_MODEL="online/openrouter/deepseek/deepseek-v4-flash"
# Host-side CLI URL. Docker Compose injects http://qdrant:6333 inside the API container.
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_COLLECTION="trackflow_knowledge"
# Verified on 2026-11-06 against all 14 canonical corpus chunks.
RAG_VECTOR_SIZE=1024
# Minimum pause after every gateway request, shared by embeddings and generation.
RAG_REQUEST_INTERVAL_SECONDS=2
# Operational resilience revision: rag-hybrid-v3.1-resilience.
# The backend deadline stays below the local Next.js proxy timeout of 90 seconds.
RAG_TOTAL_BUDGET_SECONDS=80
RAG_EMBEDDING_ATTEMPT_TIMEOUT_SECONDS=25
RAG_EMBEDDING_MIN_RETRY_TIMEOUT_SECONDS=22
RAG_GENERATION_TIMEOUT_SECONDS=20
RAG_QDRANT_TIMEOUT_SECONDS=5
RAG_RESPONSE_RESERVE_SECONDS=3
RAG_RETRY_BACKOFF_SECONDS=0.5
RAG_RETRY_MAX_BACKOFF_SECONDS=2
RAG_RETRY_JITTER_SECONDS=0.25
RAG_RETRY_AFTER_CAP_SECONDS=5
# Set capacity to 0 to disable the process-local query-embedding cache.
RAG_EMBEDDING_CACHE_CAPACITY=256
RAG_EMBEDDING_CACHE_TTL_SECONDS=600
# Calibrated from the frozen three-question calibration split on 2026-11-06.
RAG_MIN_SCORE=0.57
